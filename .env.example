# --- Telegram (required unless DRY_RUN=true) ---
# From @BotFather -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=
# Channel username (@mychannel) or numeric chat id (-1001234567890)
TELEGRAM_CHAT_ID=

# --- Behaviour ---
# true = fetch + filter + score + print, never sends to Telegram
DRY_RUN=false
# Max jobs per morning (default 50)
MAX_JOBS=50
# Where posted job ids are persisted (used for de-duplication)
STORAGE_FILE=./data/posted-jobs.json
# IANA timezone used for the date shown in the message header
TIMEZONE=Asia/Dhaka
# Seconds to wait between Telegram messages
TELEGRAM_SEND_DELAY_MS=1200
# Per-source HTTP timeout
SOURCE_TIMEOUT_MS=20000
